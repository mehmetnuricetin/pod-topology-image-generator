def generate_mermaid_locally(resources: dict) -> str:
    """
    Generate Mermaid.js flowchart syntax locally without any API calls.
    """
    lines = ["flowchart LR"]

    # Define styles matching the visual identity of the project
    lines.append("    %% Style Definitions")
    lines.append("    classDef internet fill:#F3F4F6,stroke:#1F2937,stroke-width:2px,color:#111827;")
    lines.append("    classDef ingress fill:#00BFA5,stroke:#00796B,stroke-width:2px,color:#000000;")
    lines.append("    classDef service fill:#1565C0,stroke:#0D47A1,stroke-width:2px,color:#FFFFFF;")
    lines.append("    classDef podRunning fill:#00C853,stroke:#1B5E20,stroke-width:2px,color:#FFFFFF;")
    lines.append("    classDef podPending fill:#FFD600,stroke:#F57F17,stroke-width:2px,color:#000000;")
    lines.append("    classDef podFailed fill:#D50000,stroke:#7F0000,stroke-width:2px,color:#FFFFFF;")
    lines.append("    classDef podCrash fill:#FF1744,stroke:#880E4F,stroke-width:2px,color:#FFFFFF;")
    lines.append("    classDef podUnknown fill:#607D8B,stroke:#37474F,stroke-width:2px,color:#FFFFFF;")

    # 1. Internet Node
    lines.append("    Internet((Internet))")
    lines.append("    class Internet internet;")

    ingresses = resources.get("ingresses", [])
    services = resources.get("services", [])
    pods = resources.get("pods", [])

    # Track which services and pods are linked to show connections
    linked_services = set()

    # Helper to clean node IDs
    def clean_id(name: str) -> str:
        return name.replace("-", "_").replace(".", "_").replace("/", "_")

    # 2. Ingress Nodes and connections to Internet
    for ingress in ingresses:
        name = ingress.get("metadata", {}).get("name", "")
        namespace = ingress.get("metadata", {}).get("namespace", "default")
        spec = ingress.get("spec", {})

        # Collect hosts
        hosts = []
        for rule in spec.get("rules", []):
            host = rule.get("host")
            if host:
                hosts.append(host)
        host_str = ", ".join(hosts) if hosts else "all hosts"

        node_id = f"Ingress_{clean_id(name)}"
        label = f"Ingress: {name}<br/><small>{namespace}</small><br/><small>{host_str}</small>"

        lines.append(f'    {node_id}["{label}"]')
        lines.append(f"    class {node_id} ingress;")
        lines.append(f"    Internet --> {node_id}")

        # Connect Ingress rules to backend Services
        backend_names = extract_ingress_service_names(ingress)
        for backend_name in backend_names:
            svc_node_id = f"Service_{clean_id(backend_name)}"
            lines.append(f"    {node_id} -- \"HTTP\" --> {svc_node_id}")
            linked_services.add(backend_name)

    # 3. Service Nodes
    for service in services:
        name = service.get("metadata", {}).get("name", "")
        namespace = service.get("metadata", {}).get("namespace", "default")
        spec = service.get("spec", {})
        svc_type = spec.get("type", "ClusterIP")

        # Ports
        ports_list = []
        for p in spec.get("ports", []):
            port = p.get("port")
            target_port = p.get("targetPort")
            protocol = p.get("protocol", "TCP")
            ports_list.append(f"{protocol} {port}:{target_port}")
        ports_str = ", ".join(ports_list)

        node_id = f"Service_{clean_id(name)}"
        label = f"Service: {name}<br/><small>{svc_type}</small><br/><small>{ports_str}</small>"

        lines.append(f'    {node_id}["{label}"]')
        lines.append(f"    class {node_id} service;")

        # If Ingress wasn't defined/linked, show connection from Internet if LoadBalancer / NodePort
        if name not in linked_services:
            if svc_type in ("LoadBalancer", "NodePort"):
                lines.append(f"    Internet -- \"{svc_type}\" --> {node_id}")

        # Connect Service to Pods matching selector
        selector = spec.get("selector", {})
        for pod in pods:
            pod_name = pod.get("metadata", {}).get("name", "")
            pod_namespace = pod.get("metadata", {}).get("namespace", "default")

            # Match only if same namespace
            if pod_namespace == namespace:
                pod_labels = pod.get("metadata", {}).get("labels", {})
                if selector_matches_pod(selector, pod_labels):
                    pod_node_id = f"Pod_{clean_id(pod_name)}"
                    lines.append(f"    {node_id} --> {pod_node_id}")

    # 4. Pod Nodes
    for pod in pods:
        name = pod.get("metadata", {}).get("name", "")
        namespace = pod.get("metadata", {}).get("namespace", "default")
        status = pod.get("status", {})
        phase = status.get("phase", "Unknown")

        # Determine specific detailed status (CrashLoopBackOff etc.)
        container_statuses = status.get("containerStatuses", [])
        detailed_status = phase
        for cs in container_statuses:
            waiting = cs.get("state", {}).get("waiting", {})
            reason = waiting.get("reason", "")
            if reason in ("CrashLoopBackOff", "ImagePullBackOff", "CreateContainerConfigError", "CreateContainerError"):
                detailed_status = reason
                break

        # Container image
        spec = pod.get("spec", {})
        containers = spec.get("containers", [])
        images = []
        for c in containers:
            img = c.get("image", "").split("/")[-1] # shorten image name
            images.append(img)
        images_str = ", ".join(images)

        node_id = f"Pod_{clean_id(name)}"
        label = f"Pod: {name}<br/><small>{detailed_status}</small><br/><small>{images_str}</small>"

        lines.append(f'    {node_id}["{label}"]')

        # Style pods by status
        if detailed_status == "Running":
            style_class = "podRunning"
        elif detailed_status == "Pending":
            style_class = "podPending"
        elif detailed_status in ("Failed", "ImagePullBackOff", "CreateContainerConfigError", "CreateContainerError"):
            style_class = "podFailed"
        elif detailed_status == "CrashLoopBackOff":
            style_class = "podCrash"
        else:
            style_class = "podUnknown"

        lines.append(f"    class {node_id} {style_class};")

    return "\n".join(lines)


def is_key_set(val: str) -> bool:
    if not val:
        return False
    val = val.strip()
    # Check if value is a placeholder or empty
    if val in ("", "sk-...", "luma-..."):
        return False
    if val.startswith("sk-...") or val.startswith("luma-..."):
        return False
    return True


def validate_env(provider: str):
    """Ensure required environment variables are present."""
    missing = []
    if provider in ("luma", "openai", "dalle", "openai-mermaid"):
        if not is_key_set(OPENAI_API_KEY):
            missing.append("OPENAI_API_KEY")
    if provider == "luma" and not is_key_set(LUMA_API_KEY):
        missing.append("LUMA_API_KEY or LUMA_API_TOKEN")
    if missing:
        print("ERROR: The following environment variables are not set:")
        for key in missing:
            print(f"  - {key}")
        print("\nCreate a .env.local or .env file in the plugin directory with these keys.")
        print("See .env.example for the expected format.")
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        prog="kubectl pod-topology",
        description=(
            "Generate a traffic flow diagram image for Kubernetes pods, "
            "tracing the path from Ingress -> Service -> Pod."
        ),
    )
    parser.add_argument(
        "pod_name",
        help="Target pod name (exact name or prefix).",
    )
    parser.add_argument(
        "--namespace", "-n",
        default="default",
        help="Kubernetes namespace to inspect (default: 'default', use 'all' for all namespaces).",
    )
    parser.add_argument(
        "--output", "-o",
        default="pod-topology.png",
        help="Output file path for the generated image/diagram (default: pod-topology.png).",
    )
    parser.add_argument(
        "--provider", "-p",
        choices=["luma", "openai", "dalle", "mermaid", "openai-mermaid"],
        default="luma",
        help="Diagram generation provider (default: 'luma'). Supports 'luma', 'openai' (DALL-E 3), 'mermaid' (local flowchart), 'openai-mermaid' (AI flowchart).",
    )

    args = parser.parse_args()

    # Determine provider with automatic fallback based on key availability
    provider = args.provider
    has_luma = is_key_set(LUMA_API_KEY)
    has_openai = is_key_set(OPENAI_API_KEY)

    if provider == "luma" and not has_luma:
        if has_openai:
            print("INFO: LUMA_API_KEY is not set, but OPENAI_API_KEY is present. Falling back to 'openai' provider.")
            provider = "openai"
        else:
            print("INFO: Neither LUMA_API_KEY nor OPENAI_API_KEY is set. Falling back to 'mermaid' provider (offline/local).")
            provider = "mermaid"
    elif provider in ("openai", "dalle", "openai-mermaid") and not has_openai:
        print(f"INFO: OPENAI_API_KEY is not set. Falling back to 'mermaid' provider (offline/local).")
        provider = "mermaid"

    # Adjust default output extension for Mermaid if it wasn't customized
    output_path = args.output
    if provider in ("mermaid", "openai-mermaid") and output_path == "pod-topology.png":
        output_path = "pod-topology.html"

    print("\n=== kubectl pod-topology ===\n")

    # Step 1: Validate API keys
    validate_env(provider)

    # Step 2: Gather Kubernetes resources
    print(f"[1/4] Gathering cluster resources (namespace: {args.namespace}) ...")
    resources = gather_cluster_resources(args.namespace)

    # Step 3: Filter resources for the selected pod
    print(f"[2/4] Building topology for pod: {args.pod_name} ...")
    resources = filter_resources_for_pod(resources, args.pod_name)

    total = (
        len(resources["ingresses"])
        + len(resources["services"])
        + len(resources["pods"])
    )
    print(
        f"      Found {len(resources['ingresses'])} ingress(es), "
        f"{len(resources['services'])} service(s), "
        f"{len(resources['pods'])} pod(s)."
    )

    if total == 0:
        print("WARNING: No resources found. Make sure your kubeconfig is set correctly.")

    if provider in ("mermaid", "openai-mermaid"):
        # Step 4: Generate Mermaid diagram
        if provider == "mermaid":
            print("\n[3/4] Generating topology Mermaid diagram locally ...")
            mermaid_code = generate_mermaid_locally(resources)
        else:
            print("\n[3/4] Generating topology Mermaid diagram with OpenAI ...")
            mermaid_code = generate_mermaid_with_openai(resources)

        print("\n--- Mermaid Flowchart Code ---")
        print(mermaid_code)
        print("------------------------------\n")

        print("[4/4] Saving Mermaid diagram ...")
        save_mermaid_output(mermaid_code, output_path)
    else:
        # Step 4: Analyze with OpenAI
        print("\n[3/4] Analyzing traffic flow with OpenAI ...")
        cluster_summary = analyze_with_openai(resources)

        print("\n--- Cluster Traffic Summary ---")
        print(cluster_summary)
        print("-------------------------------\n")

        # Step 5: Generate image using selected provider
        if provider == "luma":
            print("[4/4] Generating topology image with Luma AI UNI-1 ...")
            generate_image_with_luma(cluster_summary, output_path)
        else:
            print("[4/4] Generating topology image with OpenAI DALL-E 3 ...")
            generate_image_with_openai(cluster_summary, output_path)

    print("\n=== Done! ===")
    print(f"Topology diagram saved to: {Path(output_path).resolve()}\n")


if __name__ == "__main__":
    main()
