                "rules":     i.get("spec", {}).get("rules", []),
                "tls":       i.get("spec", {}).get("tls", []),
            }
            for i in resources["ingresses"]
        ],
        "services": [
            {
                "name":      s.get("metadata", {}).get("name"),
                "namespace": s.get("metadata", {}).get("namespace"),
                "type":      s.get("spec", {}).get("type"),
                "selector":  s.get("spec", {}).get("selector", {}),
                "ports":     s.get("spec", {}).get("ports", []),
            }
            for s in resources["services"]
            if s.get("spec", {}).get("type") != "ExternalName"
        ],
        "pods": [
            {
                "name":       p.get("metadata", {}).get("name"),
                "namespace":  p.get("metadata", {}).get("namespace"),
                "labels":     p.get("metadata", {}).get("labels", {}),
                "phase":      p.get("status", {}).get("phase"),
                "conditions": p.get("status", {}).get("conditions", []),
                "containers": [
                    {
                        "name":  c.get("name"),
                        "image": c.get("image"),
                        "state": p.get("status", {}).get("containerStatuses", [{}])[idx].get("state", {})
                                 if idx < len(p.get("status", {}).get("containerStatuses", []))
                                 else {},
                    }
                    for idx, c in enumerate(p.get("spec", {}).get("containers", []))
                ],
            }
            for p in resources["pods"]
        ],
    }

    system_prompt = (
        "You are a Kubernetes expert and Mermaid.js designer. Given raw Kubernetes resource data, "
        "you will produce a clean, visual Mermaid.js flowchart (graph LR) showing the traffic flow: "
        "Internet --> Ingress --> Service --> Pod.\n"
        "Use distinct styling/classes or colors for the elements:\n"
        "  - Internet: Globe/special shape.\n"
        "  - Ingress: Teal color-coded style.\n"
        "  - Service: Blue color-coded style.\n"
        "  - Pods: Color-coded based on status (Running=Green, Pending=Yellow, Failed=Red, CrashLoopBackOff=Blinking/Dark Red, Unknown=Grey).\n"
        "Keep it highly readable, with neat connection labels showing port/protocol.\n"
        "Return ONLY the raw Mermaid diagram code block. Do not include markdown formatting or explanations."
    )

    user_message = (
        "Here is the cluster resource data in JSON format:\n\n"
        + json.dumps(slim, indent=2)
    )

    print("  Generating Mermaid diagram with OpenAI ...")
    response = client.chat.completions.create(
        model="gpt-4o",
